# TraçAÍ Educação — .gitignore

# Ambiente virtual Python
venv/
.venv/
env/

# Cache Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Arquivos de IDE
.idea/
.vscode/
*.swp
*.swo

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Logs de runtime (não commitar)
*.log
alfaia_debug.log
tracaai_debug.log

# Dados sensíveis
.env

# Arquivos compactados e binários grandes (GitHub bloqueia push de arquivos > 100 MB)
*.zip
*.tar.gz
*.rar

# Assets de imagem gerados (a logo fica em assets/, não na raiz)
*.png
*.jpg
*.jpeg
!versao-ptBR/assets/*.png
!versao-ptBR/assets/*.ico
!english-version/assets/*.png
!english-version/assets/*.ico
